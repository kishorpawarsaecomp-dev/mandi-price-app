# Copy to .env (never commit .env). Get a key at https://data.gov.in (My Account -> API key)
DATA_GOV_API_KEY=
DB_URL=jdbc:postgresql://localhost:5433/mandi
DB_USER=mandi
DB_PASSWORD=mandi
# Daily sync, Spring cron (sec min hour day month weekday). Default: 19:30 every day
MANDI_SYNC_CRON=0 30 19 * * *
MANDI_SYNC_ZONE=Asia/Kolkata
# Optional comma-separated subset of states to sync (blank = all states)
MANDI_SYNC_STATES=
MANDI_SYNC_ON_STARTUP=false
# Enables POST /api/mandi/sync (send header X-Admin-Token). Blank = endpoint disabled
MANDI_ADMIN_TOKEN=
# Trend indicator: recent-half avg vs earlier-half avg, +/- this percent => Rising/Falling
MANDI_TREND_THRESHOLD=3.0
MANDI_CORS_ORIGINS=http://localhost:5173
